# Turso Database Configuration
# For production: libsql://<your-db-name>-<user>.turso.io
# If left empty, falls back to local file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google OAuth Configuration (for Google Sheets sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL (for OAuth redirect)
# Use http://localhost:5173 for local dev; change to production domain when deployed
PUBLIC_BASE_URL=http://localhost:5173

# Security: Only your Google email allowed to access (leave empty or set allowed email)
ALLOWED_EMAIL=

# Random 32+ character string for cookie encryption
AUTH_SECRET=
